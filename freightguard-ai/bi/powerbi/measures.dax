// Tables: mv_invoice_facts (fact), mv_carrier_recovery, mv_typology_monthly, v_dispute_outcomes, 'Date' (calendar)
Total Billed = SUM ( mv_invoice_facts[billed_total] )
Identified Overcharge = SUM ( mv_invoice_facts[total_overcharge] )
Overbilling Rate % = DIVIDE ( COUNTROWS ( FILTER ( mv_invoice_facts, mv_invoice_facts[is_overbilled] = TRUE () ) ), COUNTROWS ( mv_invoice_facts ) )
Flagged Invoices = CALCULATE ( COUNTROWS ( mv_invoice_facts ), mv_invoice_facts[flagged] = TRUE () )
Flag Precision = DIVIDE ( CALCULATE ( COUNTROWS ( mv_invoice_facts ), mv_invoice_facts[flagged] = TRUE (), mv_invoice_facts[is_overbilled] = TRUE () ), [Flagged Invoices] )
Approval Rate % = DIVIDE ( CALCULATE ( COUNTROWS ( v_dispute_outcomes ), v_dispute_outcomes[action] IN { "approve", "edit" } ), COUNTROWS ( v_dispute_outcomes ) )
Overcharge MoM % = VAR cur = [Identified Overcharge] VAR prev = CALCULATE ( [Identified Overcharge], DATEADD ( 'Date'[Date], -1, MONTH ) ) RETURN DIVIDE ( cur - prev, prev )
Overcharge YTD = TOTALYTD ( [Identified Overcharge], 'Date'[Date] )
Savings % of Spend = DIVIDE ( [Identified Overcharge], [Total Billed] )
